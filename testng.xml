<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Practo Cross-Browser Suite">

	<listeners>
        <listener class-name="com.hackathonproject.listeners.TestListener"/>
    </listeners>

    <test name="Edge Test">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.hackathonproject.runner.TestRunner"/>
        </classes>
    </test>

    <test name="Chrome Test">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.hackathonproject.runner.TestRunner"/>
        </classes>
    </test>

    <!--<test name="Firefox Test">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.hackathonproject.runner.TestRunner"/>
        </classes>
    </test>-->

</suite>